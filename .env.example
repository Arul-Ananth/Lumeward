# Change only this field to switch runtimes. Desktop ignores server storage URLs.
APP_MODE=SERVER
APP_VERSION=1.0.0-beta.1
SECRET_KEY=change_me

# Server networking
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_WORKERS=1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server storage (required in APP_MODE=SERVER; ignored in DESKTOP)
DATABASE_URL=postgresql+psycopg://lumeward:change_me@127.0.0.1:5432/lumeward
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# `external` uses an administrator-managed Qdrant service. `bundled` starts the
# platform-specific Qdrant executable supplied by an enterprise installer.
QDRANT_MODE=external
QDRANT_URL=http://127.0.0.1:6333
# Optional; leave empty when local Qdrant authentication is disabled.
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PREFER_GRPC=false
BUNDLED_QDRANT_BINARY=
BUNDLED_QDRANT_CONFIG_PATH=
BUNDLED_QDRANT_STORAGE_DIR=
BUNDLED_QDRANT_STARTUP_TIMEOUT_SECONDS=30
INGESTION_CONCURRENCY=2

# Auth mode
# Canonical values: shared or interactive. `trusted_lan` remains accepted for legacy env files.
AUTH_MODE=shared
TRUSTED_LAN_MODE=true
TRUSTED_LAN_USER_EMAIL=local@lan
TRUSTED_LAN_USER_NAME=Trusted LAN User
AUTH_SESSION_EXPIRE_MINUTES=720
# Used to construct copyable invitation links. Do not include a trailing slash.
FRONTEND_PUBLIC_URL=http://localhost:5173
INVITATION_EXPIRE_DAYS=7
# SMTP is optional. When host/from are empty, invitations remain usable through
# the copyable link returned to the organization administrator.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Desktop enterprise connection. This can also be set in Desktop Settings.
ENTERPRISE_SERVER_URL=
# Fast operations use the request timeout; AI generation gets a longer read timeout.
ENTERPRISE_REQUEST_TIMEOUT_SECONDS=15
ENTERPRISE_GENERATION_TIMEOUT_SECONDS=600

# LLM config
LLM_PROVIDER=ollama
OPENAI_API_BASE=http://localhost:11434
OPENAI_MODEL_NAME=mistral:latest
OPENAI_API_KEY=
GEMINI_API_KEY=
# Bound individual model calls and agent loops. Lower token counts are faster on local CPU inference.
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=256
CREW_MAX_ITERATIONS=3
CREW_MAX_EXECUTION_TIME_SECONDS=240
# Optional for the public sentence-transformers model; improves Hugging Face
# Hub rate limits and download reliability.
HF_TOKEN=
SERPER_API_KEY=
ALLOW_SERVER_DDG_FALLBACK=false

# Optional remote OpenAI-compatible engine
ENGINE_ENABLED=false
ENGINE_BASE_URL=http://192.168.1.50:8001/v1
ENGINE_API_KEY=
ENGINE_MODEL_NAME=
ENGINE_TIMEOUT_SECONDS=30
ENGINE_MAX_RETRIES=2

# Logging/data
LOG_LEVEL=INFO
DATA_COLLECTION_ENABLED=false
CLIPBOARD_COLLECTION_ENABLED=false
CLIPBOARD_STORE_RAW_TEXT=false
CLIPBOARD_MAX_CHARS=50000

# Folder upload ingestion
FOLDER_UPLOAD_ENABLED=true
FOLDER_UPLOAD_DIR=uploads/folders
FOLDER_UPLOAD_DELETE_ON_RESTART=true
FOLDER_UPLOAD_MAX_ARCHIVE_MB=250
FOLDER_UPLOAD_MAX_EXPANDED_MB=1000
FOLDER_UPLOAD_MAX_FILES=500
