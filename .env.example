APP_MODE=SERVER
APP_VERSION=1.0.0-beta.1
SECRET_KEY=change_me

# Server networking
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth mode
AUTH_MODE=trusted_lan
TRUSTED_LAN_MODE=true
TRUSTED_LAN_USER_EMAIL=local@lan
TRUSTED_LAN_USER_NAME=Trusted LAN User
AUTH_SESSION_EXPIRE_MINUTES=720

# LLM config
LLM_PROVIDER=ollama
OPENAI_API_BASE=http://localhost:11434
OPENAI_MODEL_NAME=mistral:latest
OPENAI_API_KEY=
GEMINI_API_KEY=
SERPER_API_KEY=
ALLOW_SERVER_DDG_FALLBACK=false

# Optional remote OpenAI-compatible engine
ENGINE_ENABLED=false
ENGINE_BASE_URL=http://192.168.1.50:8001/v1
ENGINE_API_KEY=
ENGINE_MODEL_NAME=
ENGINE_TIMEOUT_SECONDS=30
ENGINE_MAX_RETRIES=2

# Logging/data
LOG_LEVEL=INFO
DATA_COLLECTION_ENABLED=false
CLIPBOARD_COLLECTION_ENABLED=false
CLIPBOARD_STORE_RAW_TEXT=false
CLIPBOARD_MAX_CHARS=50000

# Folder upload ingestion
FOLDER_UPLOAD_ENABLED=true
FOLDER_UPLOAD_DIR=uploads/folders
FOLDER_UPLOAD_DELETE_ON_RESTART=true
FOLDER_UPLOAD_MAX_ARCHIVE_MB=10240
FOLDER_UPLOAD_MAX_FILES=500
